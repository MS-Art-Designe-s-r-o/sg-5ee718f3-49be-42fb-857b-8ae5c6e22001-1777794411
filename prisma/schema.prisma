// Prisma schéma pre backend portál E-TAXI Košice.
// Databáza: MySQL / MariaDB (hosting Polar55, cPanel).
// binaryTargets pokrýva vývoj (native) aj cPanel/CloudLinux (rhel-openssl-3.0.x).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MAJITEL
  DISPECER
  VODIC
}

enum DruhPohonu {
  ELEKTRO
  HYBRID
  BENZIN
  DIESEL
  LPG
  CNG
}

enum TypSmeny {
  DENNA // D
  NOCNA // N
  VOLNO // V
  H24 // 24 hod — obsadí dennú aj nočnú
}

enum ExpenseInterval {
  TYZDENNE
  MESACNE
  STVRTROCNE
  POLROCNE
  ROCNE
}

enum TypBloku {
  NEDOSTUPNE
  SERVIS
}

enum RozsahBloku {
  CELY_DEN
  DENNA
  NOCNA
}

enum VlastnikTyp {
  ETAXI
  FLOTILA
}

enum TypZmluvy {
  NAJOM
  DISPECING
}

enum NajomneJednotka {
  ZMENA
  DEN
  TYZDEN
  MESIAC
}

enum StavZmluvy {
  NAVRH
  VYGENEROVANA
  PODPISANA
  UKONCENA
  NAHRADENA
}

enum DriverStav {
  AKTIVNY
  POZASTAVENY
  UKONCENY
}

enum DriverRezim {
  VO_FLOTILE
  VLASTNA_KONCESIA
}

enum StranaTyp {
  FYZICKA_OSOBA
  PRAVNICKA_OSOBA
}

/// Prihlasovací účet aj osoba (vodič / dispečer / majiteľ).
model User {
  id                          Int        @id @default(autoincrement())
  email                       String     @unique
  passwordHash                String?
  meno                        String
  priezvisko                  String
  telefon                     String?
  volaciZnak                  String?    @unique // len vodiči, napr. "E10"
  miestoStriedania            String?    // miesto striedania vodičov (pre kontakty)
  aktivny                     Boolean    @default(true)
  mustSetPassword             Boolean    @default(true)
  registracnyPoplatokUhradeny Boolean    @default(false)
  registracnyPoplatokDna      DateTime?
  passwordResetToken          String?    @unique
  passwordResetExpires        DateTime?
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  roles           UserRole[]
  shifts          Shift[]    @relation("DriverShifts")
  createdShifts   Shift[]    @relation("ShiftCreator")
  revenues        Revenue[]  @relation("DriverRevenues")
  createdRevenues Revenue[]  @relation("RevenueCreator")
  driverProfile   DriverProfile?
  contracts       Contract[] @relation("ContractDriver")
  auditLogs       AuditLog[]

  @@index([aktivny])
}

/// Roly používateľa (M:N cez join). Jeden používateľ môže mať viac rolí.
model UserRole {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  role   Role

  @@unique([userId, role])
  @@index([role])
}

/// Firemné vozidlo.
model Vehicle {
  id             Int        @id @default(autoincrement())
  nazov          String // napr. "Tesla 3"
  znacka         String
  model          String
  farba          String
  spz            String     @unique
  druhPohonu     DruhPohonu
  poplatokZaSmenu Decimal   @db.Decimal(10, 2) @default(0.00) // predvolený poplatok za (12h) smenu na tomto vozidle
  poplatokZa24h  Decimal    @db.Decimal(10, 2) @default(0.00) // poplatok za 24h prenájom
  lizing         Decimal    @db.Decimal(10, 2) @default(0.00) // mesačný lízing — prenáša sa do výdavkov
  poistenie      Decimal    @db.Decimal(10, 2) @default(0.00) // mesačné poistenie — prenáša sa do výdavkov
  sukromne       Boolean    @default(false) // súkromné vozidlo — neponúka sa medzi voľnými smenami
  casVymeny      String?    // čas výmeny denná↔nočná, napr. "18:00"
  aktivne        Boolean    @default(true)
  // Zmluvné údaje (migrácia 0010) — predvolené hodnoty pre modál zmluvy
  vin                 String?       @unique @db.VarChar(17)
  rokVyroby           Int?          @db.SmallInt
  cisloTp             String?       @db.VarChar(30) // číslo technického preukazu
  datumPrvejEvidencie DateTime?     @db.Date
  vlastnikTyp         VlastnikTyp   @default(ETAXI)
  vlastnikFleet       Fleet?        @relation(fields: [vlastnikFleetId], references: [id], onDelete: SetNull)
  vlastnikFleetId     Int?
  poistovna           String?
  pzpCislo            String?       @db.VarChar(50)
  pzpPlatnostDo       DateTime?     @db.Date
  havCislo            String?       @db.VarChar(50)
  havPlatnostDo       DateTime?     @db.Date
  stkPlatnostDo       DateTime?     @db.Date
  ekPlatnostDo        DateTime?     @db.Date
  stavKm              Int?
  kaucia              Decimal?      @db.Decimal(10, 2)
  spoluucast          Decimal?      @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  shifts   Shift[]
  expenses Expense[]
  blocks   VehicleBlock[]
  contracts Contract[]

  @@index([aktivne])
  @@index([vlastnikFleetId])
}

/// Časové blokovanie vozidla (nedostupné / servis) — v tomto období sa naň
/// nedá priradiť smena a existujúce smeny sa hlásia ako kolízia.
model VehicleBlock {
  id          Int      @id @default(autoincrement())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId   Int
  typ         TypBloku
  rozsah      RozsahBloku @default(CELY_DEN) // pri viacdňovom intervale platí pre posledný deň
  datumOd     DateTime @db.Date
  datumDo     DateTime @db.Date
  poznamka    String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId, datumOd, datumDo])
}

/// Jedna smena vodiča v konkrétny deň (D/N/V), voliteľne na firemnom vozidle.
model Shift {
  id          Int      @id @default(autoincrement())
  datum       DateTime @db.Date
  typ         TypSmeny
  poznamka    String?
  // Poplatok za smenu — prednastavený z vozidla, editovateľný. Eviduje sa jeho úhrada.
  poplatokZaSmenu     Decimal?  @db.Decimal(10, 2)
  poplatokUhradeny    Boolean   @default(false)
  poplatokUhradenyDna DateTime?
  driver      User     @relation("DriverShifts", fields: [driverId], references: [id], onDelete: Cascade)
  driverId    Int
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId   Int?
  createdBy   User?    @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([driverId, datum])
  @@index([datum])
  @@index([vehicleId, datum])
  @@index([poplatokUhradeny])
}

/// Týždenná tržba vodiča + dopočítané poplatky.
model Revenue {
  id              Int      @id @default(autoincrement())
  driver          User     @relation("DriverRevenues", fields: [driverId], references: [id], onDelete: Cascade)
  driverId        Int
  isoRok          Int
  isoTyzden       Int
  trzba           Decimal  @db.Decimal(10, 2)
  poplatokApp     Decimal  @db.Decimal(10, 2)
  provizia        Decimal  @db.Decimal(10, 2)
  celkovyPoplatok Decimal  @db.Decimal(10, 2)
  uhradene        Boolean  @default(false)
  uhradeneDna     DateTime?
  createdBy       User?    @relation("RevenueCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([driverId, isoRok, isoTyzden])
  @@index([isoRok, isoTyzden])
  @@index([uhradene])
}

/// Tarifné pásma pre poplatok za aplikáciu (editovateľné majiteľom).
model FeeTier {
  id       Int      @id @default(autoincrement())
  trzbaOd  Decimal  @db.Decimal(10, 2)
  trzbaDo  Decimal? @db.Decimal(10, 2) // null = "a viac"
  poplatok Decimal  @db.Decimal(10, 2)
  poradie  Int      @default(0)

  @@index([poradie])
}

/// Kľúč/hodnota konfigurácia (provízia %, registračný poplatok, ...).
model AppSetting {
  key   String @id
  value String
}

/// Kategórie výdavkov (editovateľný číselník).
model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  nazov    String    @unique
  poradie  Int       @default(0)
  aktivna  Boolean   @default(true)
  expenses Expense[]

  @@index([poradie])
}

/// Výdavok firmy. Môže byť jednorazový alebo pravidelný (predpis v intervale).
/// Ak je naviazaný na vozidlo (lízing/poistenie), synchronizuje sa z vozidla.
model Expense {
  id           Int              @id @default(autoincrement())
  datum        DateTime         @db.Date
  popis        String
  suma         Decimal          @db.Decimal(10, 2)
  uhradene     Boolean          @default(false)
  uhradeneDna  DateTime?
  pravidelny   Boolean          @default(false)
  interval     ExpenseInterval?
  datumDo      DateTime?        @db.Date // koniec pravidelného predpisu (výskyty po ňom sa nezobrazujú)
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id])
  categoryId   Int
  // Ak výdavok pochádza z vozidla (lízing/poistenie), je naviazaný sem.
  vehicle      Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId    Int?
  zdroj        String           @default("MANUAL") // MANUAL | VOZIDLO_LIZING | VOZIDLO_POISTENIE
  createdById  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  occurrences  ExpenseOccurrence[]

  @@index([datum])
  @@index([categoryId])
  @@index([vehicleId])
  @@index([pravidelny])
}

/// Stav jednotlivého výskytu pravidelného výdavku (úhrada per výskyt,
/// prípadne vynechanie jedného výskytu).
model ExpenseOccurrence {
  id          Int       @id @default(autoincrement())
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId   Int
  datum       DateTime  @db.Date
  uhradene    Boolean   @default(false)
  uhradeneDna DateTime?
  vynechany   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([expenseId, datum])
  @@index([expenseId])
}

/// Uložený vlastný rotačný vzor smien (reťazec kódov D/N/V/H; dĺžka = cyklus).
model ShiftPattern {
  id          Int      @id @default(autoincrement())
  nazov       String
  dni         String   // napr. "DNVHVVV..." (kódy D/N/V/H)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Modul zmlúv (návrh: docs/zmluvy-navrh.md) ──────────────────────────────────

/// Údaje prevádzkovateľa (E-TAXI). Vždy práve jeden riadok s id = 1.
model CompanyProfile {
  id              Int      @id @default(1)
  obchodneMeno    String
  ico             String?  @db.VarChar(20)
  dic             String?  @db.VarChar(20)
  icDph           String?  @db.VarChar(20)
  sidlo           String?  @db.VarChar(255)
  zapisanyV       String?  @db.VarChar(255) // obchodný register
  statutar        String?
  statutarFunkcia String?
  iban            String?  @db.VarChar(34)
  email           String?
  telefon         String?  @db.VarChar(50)
  web             String?
  updatedAt       DateTime @default(now()) @updatedAt
}

/// Flotila — externý prevádzkovateľ vozidiel.
model Fleet {
  id             Int      @id @default(autoincrement())
  obchodneMeno   String
  ico            String?  @unique @db.VarChar(20)
  dic            String?  @db.VarChar(20)
  icDph          String?  @db.VarChar(20)
  sidlo          String?  @db.VarChar(255)
  zapisanyV      String?  @db.VarChar(255)
  statutar       String?
  cisloKoncesie  String?  @db.VarChar(50)
  iban           String?  @db.VarChar(34)
  kontaktMeno    String?
  kontaktTelefon String?  @db.VarChar(50)
  kontaktEmail   String?
  poznamka       String?  @db.VarChar(500)
  aktivna        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  agreements FleetAgreement[]
  drivers    DriverProfile[]
  vehicles   Vehicle[]
  contracts  Contract[]

  @@index([aktivna])
}

/// Dohoda medzi E-TAXI a flotilou.
model FleetAgreement {
  id             Int       @id @default(autoincrement())
  fleet          Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  fleetId        Int
  cislo          String    @db.VarChar(60)
  datumUzavretia DateTime  @db.Date
  platnostOd     DateTime  @db.Date
  platnostDo     DateTime? @db.Date
  poznamka       String?   @db.VarChar(500)

  @@index([fleetId])
}

/// Profil vodiča (osobné a zmluvné údaje, 1:1 s User). Rodné číslo a číslo OP
/// sú šifrované aplikačne (AES-256-GCM), rodneCisloBidx = HMAC blind index
/// len na detekciu duplicity.
model DriverProfile {
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int          @id
  titulPred          String?      @db.VarChar(50)
  titulZa            String?      @db.VarChar(50)
  datumNarodenia     DateTime?    @db.Date
  rodneCisloEnc      String?      @db.VarChar(255)
  rodneCisloBidx     String?      @unique @db.Char(64)
  cisloOpEnc         String?      @db.VarChar(255)
  trvalyPobyt        String?      @db.VarChar(255)
  cisloVp            String?      @db.VarChar(50)
  cisloPvt           String?      @db.VarChar(50)
  pvtPlatnostDo      DateTime?    @db.Date
  iban               String?      @db.VarChar(34)
  stav               DriverStav   @default(AKTIVNY)
  fleet              Fleet?       @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  fleetId            Int?
  rezim              DriverRezim?
  stranaTyp          StranaTyp?
  firmaObchodneMeno  String?
  firmaIco           String?      @db.VarChar(20)
  firmaDic           String?      @db.VarChar(20)
  firmaIcDph         String?      @db.VarChar(20)
  firmaSidlo         String?      @db.VarChar(255)
  firmaZapisanyV     String?      @db.VarChar(255)
  cisloKoncesie      String?      @db.VarChar(50)
  koncesiaPlatnostDo DateTime?    @db.Date
  firmaStatutar      String?
  anonymizedAt       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  @@index([fleetId])
  @@index([stav])
}

/// Audit log (len INSERT; retencia 5 rokov rieši skript).
model AuditLog {
  id       BigInt   @id @default(autoincrement())
  at       DateTime @default(now())
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId   Int?
  action   String   @db.VarChar(40)
  entity   String   @db.VarChar(30)
  entityId Int?
  ip       String?  @db.VarChar(45)
  meta     Json?

  @@index([entity, entityId])
  @@index([userId, at])
  @@index([at])
}

/// Šablóna zmluvy (DOCX na disku, v DB relatívna cesta + SHA-256).
/// `aktivnaTyp` je generovaný STORED stĺpec IF(aktivna, typ, NULL) s UNIQUE
/// (najviac jedna aktívna šablóna na typ) — vytvorený ručne v migrácii 0011.
model ContractTemplate {
  id          Int        @id @default(autoincrement())
  typ         TypZmluvy
  nazov       String
  verzia      Int
  suborPath   String     @db.VarChar(500)
  sha256      String     @db.Char(64)
  platnaOd    DateTime   @db.Date
  aktivna     Boolean    @default(false)
  aktivnaTyp  Unsupported("VARCHAR(10)")? @unique
  tagy        Json?
  createdById Int?
  createdAt   DateTime   @default(now())

  contracts Contract[]

  @@unique([typ, verzia])
}

/// Číselník poradových čísel zmlúv (NZ-RRRR-NNN / DS-RRRR-NNN).
model ContractSequence {
  prefix   String @db.VarChar(4)
  rok      Int    @db.SmallInt
  posledne Int    @default(0)

  @@id([prefix, rok])
}

/// Zmluva (nájomná alebo dispečerská). Vygenerovaný dokument sa neprerenderuje;
/// platí šifrovaný snapshot údajov. Regenerácia = nový riadok (verzia + 1).
model Contract {
  id                  Int             @id @default(autoincrement())
  cislo               String          @db.VarChar(20)
  verzia              Int             @default(1)
  nahradza            Contract?       @relation("ContractNahradza", fields: [nahradzaId], references: [id], onDelete: SetNull)
  nahradzaId          Int?
  nahradeneVerzie     Contract[]      @relation("ContractNahradza")
  typ                 TypZmluvy
  driver              User            @relation("ContractDriver", fields: [driverId], references: [id], onDelete: Restrict)
  driverId            Int
  fleet               Fleet?          @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  fleetId             Int?
  vehicle             Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId           Int?
  template            ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateId          Int
  datumUzavretia      DateTime        @db.Date
  platnostOd          DateTime        @db.Date
  platnostDo          DateTime?       @db.Date
  najomneSuma         Decimal?        @db.Decimal(10, 2)
  najomneJednotka     NajomneJednotka @default(ZMENA)
  najomne24h          Decimal?        @db.Decimal(10, 2)
  kaucia              Decimal?        @db.Decimal(10, 2)
  spoluucast          Decimal?        @db.Decimal(10, 2)
  stavKmOdovzdanie    Int?
  provizia            Decimal?        @db.Decimal(5, 2)
  poplatokRegistracny Decimal?        @db.Decimal(10, 2)
  stav                StavZmluvy      @default(NAVRH)
  podpisanaDna        DateTime?       @db.Date
  ukoncenaDna         DateTime?       @db.Date
  docxPath            String          @db.VarChar(500)
  pdfPath             String?         @db.VarChar(500)
  snapshotEnc         String          @db.MediumText
  snapshotSha256      String          @db.Char(64)
  onedriveItemId      String?
  onedriveSyncedAt    DateTime?
  onedriveError       String?         @db.VarChar(500)
  createdById         Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt

  @@unique([cislo, verzia])
  @@index([driverId])
  @@index([vehicleId, stav])
  @@index([typ, stav])
  @@index([nahradzaId])
  @@index([fleetId])
  @@index([templateId])
}
