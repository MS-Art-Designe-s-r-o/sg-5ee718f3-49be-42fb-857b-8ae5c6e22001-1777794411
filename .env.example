# SMTP Email Configuration (WebSupport)
# CRITICAL: Never commit .env.local to git!

SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_USER=dispecing@e-taxike.sk
SMTP_PASS=your_password_here

# Optional: Site URL
NEXT_PUBLIC_SITE_URL=https://e-taxike.sk

# ─── Blog (publikuje AI agent Šefko cez /api/blog) ──────────────────────────────
# Tajný token na publikovanie príspevkov. Vygenerujte napr.: openssl rand -hex 24
# Šefko ho posiela v hlavičke: Authorization: Bearer <token>
BLOG_API_TOKEN=
# (voliteľné) iná cesta k dátovému súboru blogu; default ./data/blog-posts.json
# BLOG_DATA_FILE=/home/etaxikes/etaxi-web/data/blog-posts.json

# ─── Google recenzie (živý rating, počet a cca 5 recenzií) ──────────────────────
# API kľúč z Google Cloud Console (povolené "Places API").
GOOGLE_PLACES_API_KEY=
# (voliteľné) Place ID firmy; ak chýba, dohľadá sa podľa názvu nižšie.
GOOGLE_PLACE_ID=
# (voliteľné) názov na dohľadanie Place ID; default "E-TAXI Košice"
GOOGLE_PLACE_QUERY=E-TAXI Košice

# ─── Portál (backend) ──────────────────────────────────────────────────────────

# Databáza MySQL/MariaDB z hostingu Polar55 (cPanel → MySQL Databases).
# Formát: mysql://POUZIVATEL:HESLO@HOST:PORT/DATABAZA
DATABASE_URL=mysql://etaxi_user:heslo@localhost:3306/etaxi_portal

# Tajný kľúč na podpisovanie prihlasovacích tokenov (min. 32 náhodných znakov).
# Vygenerujte napr.: openssl rand -hex 32
AUTH_JWT_SECRET=zmente_ma_na_dlhy_nahodny_retazec

# Cloudflare Turnstile — overenie, že sa prihlasuje človek (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Prvý majiteľ (vytvorí sa pri `npm run seed`, ak ešte neexistuje)
INITIAL_OWNER_EMAIL=majitel@e-taxike.sk
INITIAL_OWNER_PASSWORD=zmente_toto_heslo
INITIAL_OWNER_MENO=Meno
INITIAL_OWNER_PRIEZVISKO=Priezvisko

# ─── Šifrovanie osobných údajov (modul zmlúv) ──────────────────────────────────
# AES-256-GCM kľúče na rodné číslo, číslo OP a snapshot zmluvy. Formát:
#   FIELD_ENC_KEYS="k1:<base64 32 B>,k2:<base64 32 B>"  (všetky kľúče, aj staré)
#   FIELD_ENC_ACTIVE=k1                                (kľúč na nové šifrovanie)
# Vygenerujte kľúč (32 B v base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# POZOR: bez kľúča sa zašifrované údaje už nedajú prečítať — zálohujte ho mimo servera.
# Bez nastavených kľúčov portál beží, len profil vodiča (RČ/OP) a zmluvy hlásia chybu.
FIELD_ENC_KEYS=
FIELD_ENC_ACTIVE=k1
# HMAC kľúč pre blind index rodného čísla (detekcia duplicít), base64 aspoň 32 B —
# vygenerujte rovnakým príkazom. Po nasadení ho NEMEŇTE (indexy by prestali sedieť).
FIELD_HMAC_KEY=
